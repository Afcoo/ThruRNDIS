//
// Copy this file to LocalSigning.xcconfig and fill in local signing values for
// runtime USB passthrough, virtualization, and privileged-helper validation.
// Register the app bundle ID for the selected team. The privileged-helper
// identifier is derived from the app identifier and does not use a provisioning
// profile. Public Developer ID distribution additionally requires the exact
// installed app profile name containing the restricted direct-distribution
// entitlements used by Distribution.entitlements.
//

DEVELOPMENT_TEAM = YOURTEAMID
THRURNDIS_APP_BUNDLE_IDENTIFIER = com.example.thrurndis.local
THRURNDIS_APP_DISTRIBUTION_PROVISIONING_PROFILE = ThruRNDIS Developer ID
